<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gaozimeng.pulse.helper</string>
    <!-- 相对路径(2026-10-27 全天对拍定案):只有两条实证成功组合——
         相对路径 + 用户批准链路部署(探针 09 与当日 14:52 两次)。绝对路径
         被快速重注册链拒(BundleProgram lint 警告 + Launch Constraint
         Violation 移除);相对路径被快速重注册链以原文 exec 拒(EX_CONFIG)。
         → 快速重注册链路两条都死,唯一活路 = 批准链 + 相对路径。运维口径:
         换 bundle(二进制/plist 变)后必须 bootout → 重开开关 → 系统设置
         重新批准一次(配置变即视为新后台项)。 -->
    <key>BundleProgram</key>
    <string>Contents/Library/LaunchDaemons/pulse-helper</string>
    <key>RunAtLoad</key>
    <true/>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.gaozimeng.pulse</string>
    </array>
</dict>
</plist>
